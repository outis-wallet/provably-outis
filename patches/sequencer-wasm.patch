+//! Native checks: `os <virtual-os-input.json>` runs the virtual OS and prints the PIE summary;
+//! `verify <response.json>` verifies a starknet_proveTransaction result.
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let usage = "usage: os_native_probe os <virtual-os-input.json> | verify <response.json>";
+    let (mode, path) = match args.as_slice() {
+        [_, mode, path] => (mode.as_str(), path.as_str()),
+        [_, path] => ("os", path.as_str()),
+        _ => panic!("{usage}"),
+    };
+    let input = std::fs::read(path).expect("read input");
+    let started = std::time::Instant::now();
+    match mode {
+        "os" => {
+            let pie = os_wasm_probe::run(&input).expect("virtual OS run");
+            println!("{} in {:.2} s", os_wasm_probe::summary(&pie), started.elapsed().as_secs_f64());
+        }
+        "verify" => {
+            let verdict = os_wasm_probe::verify_result(std::str::from_utf8(&input).expect("utf8"));
+            println!("{verdict:?} in {:.2} s", started.elapsed().as_secs_f64());
+        }
+        _ => panic!("{usage}"),
+    }
+}
