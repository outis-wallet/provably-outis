+            if at(i, 0) != 0 {
+                continue;
+            }
+            let powers: Vec<u64> = (0..log_size).map(|k| at(i, 1 << k)).collect();
+            let nonzero: Vec<usize> = (0..log_size as usize).filter(|&k| powers[k] != 0).collect();
