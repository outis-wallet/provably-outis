+                let values = if cosets.is_empty() {
+                    values
+                } else {
+                    let whole_values = values
+                        .to_cpu()
+                        .into_iter()
+                        .chain(cosets.iter().flat_map(|c| c.to_cpu()))
+                        .collect();
+                    base_column_pool.give_back(values.len().ilog2(), values);
+                    for coset in cosets {
+                        base_column_pool.give_back(coset.len().ilog2(), coset);
+                    }
+                    whole_values
+                };
+                let mut evals = CircleEvaluation::new(
+                    part_domain(domain, domain.log_size() - values.len().ilog2(), 0),
+                    values,
+                );
+                evals.domain = domain;
+                Poly::new(Some(coeffs), evals)
+            })
+            .collect();
+        CommitmentTreeProver { polynomials, commitment }
+    }
+
+    /// Keeps, of every column with stored coefficients, only the first
+    /// `2^(coefficients log size + log_expansion)` evaluations: in bit-reversed order, the
+    /// evaluations on the subdomain that constraint evaluation reads (and whose first
+    /// `2^(coefficients log size)` the FRI quotients read). The rest of the evaluations, which only
+    /// the commitment and the openings read, is let go; [`Self::decommit`] evaluates the opened
+    /// rows of such a column from its coefficients. Small columns are kept whole.
+    pub fn retain_prefixes(&mut self, log_expansion: u32) {
+        /// Columns with fewer evaluations are kept whole.
+        const MIN_RETAINED_LOG_SIZE: u32 = 14;
+        /// Columns with at least this many evaluations (2 MiB) are shortened in place and their
+        /// tail pages released; the prefixes of smaller ones are copied out.
+        const IN_PLACE_LOG_SIZE: u32 = 19;
+        let retain = |poly: &mut Poly<B>| {
+            let Some(coeffs) = &poly.coeffs else { return };
+            let log_size = poly.evals.domain.log_size();
+            let prefix_log_size = coeffs.log_size() + log_expansion;
