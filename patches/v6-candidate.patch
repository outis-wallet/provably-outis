+                .dedup()
+                .map(|log_size| {
+                    let domain = CanonicCoset::new(log_size).circle_domain();
+                    (log_size, B::part_twiddles(domain, log_parts, part, twiddles))
+                })
+                .collect();
+            let buffers = domains
+                .iter()
+                .map(|domain| base_column_pool.take_or_alloc(domain.log_size() - log_parts))
+                .collect_vec();
+            let evaluate =
+                |((poly, domain), buffer): ((&CircleCoefficients<B>, &CircleDomain), _)| {
+                    let part_domain = part_domain(*domain, log_parts, part);
+                    let twiddles = &part_twiddles[&domain.log_size()];
+                    B::evaluate_into(poly, part_domain, twiddles, buffer).values
+                };
+            #[cfg(feature = "parallel")]
+            {
+                use rayon::iter::{IndexedParallelIterator, IntoParallelIterator};
+                polynomials
+                    .par_iter()
+                    .zip(domains.par_iter())
+                    .zip(buffers.into_par_iter())
+                    .map(evaluate)
+                    .collect()
+            }
+            #[cfg(not(feature = "parallel"))]
+            polynomials.iter().zip(&domains).zip(buffers).map(evaluate).collect()
+        };
+        let hash = |columns: &[Col<B, BaseField>], height: u32| {
+            let sorted = order.iter().map(|&i| &columns[i]).collect_vec();
+            B::build_layers_sparse(&sorted, height)
+        };
+
+        // The kept part, and then parts of as many cosets but at most a quarter of the domain:
+        // the cosets of one part share the reading of the coefficients.
+        let log_part_cosets = log_expansion.min(log_blowup_factor.saturating_sub(2));
+        let part_height = lifting_log_size - log_blowup_factor + log_part_cosets;
+        let _span1 = span!(Level::INFO, "Extension and Merkle", part = 0).entered();
+        let prefix = evaluate_part(log_blowup_factor - log_expansion, 0);
+        let mut subtrees =
+            vec![hash(&prefix, lifting_log_size - log_blowup_factor + log_expansion)];
+        drop(_span1);
+        let mut whole_cosets: Vec<Vec<Col<B, BaseField>>> = vec![vec![]; polynomials.len()];
+        let log_parts = log_blowup_factor - log_part_cosets;
+        for part in (1 << (log_expansion - log_part_cosets))..(1 << log_parts) {
+            let _span = span!(Level::INFO, "Extension and Merkle", part).entered();
+            let values = evaluate_part(log_parts, part);
+            subtrees.push(hash(&values, part_height));
+            for (i, column) in values.into_iter().enumerate() {
+                if whole[i] {
+                    whole_cosets[i].push(column);
+                } else {
+                    base_column_pool.give_back(column.len().ilog2(), column);
+                }
+            }
+        }
+
+        // The parts' buffers, idle in the pool now, are of no use to the next tree, whose columns
+        // have other sizes: they go.
+        base_column_pool.release_idle();
+
+        // The layers below the subtrees' roots, side by side in the order of the rows (a layer the
+        // subtrees leave empty stays empty), and then the layers above.
+        let mut layers: Vec<Col<B, <MC::H as MerkleHasherLifted>::Hash>> = (0..=part_height
+            as usize)
+            .map(|level| {
+                if subtrees.iter().any(|subtree| subtree[level].is_empty()) {
+                    return std::iter::empty().collect();
+                }
+                subtrees.iter().flat_map(|subtree| subtree[level].to_cpu()).collect()
