+                poly.evals.values = std::iter::empty().collect();
+            }
+        }
+    }
+
+    /// Evaluates again, for every column whose evaluations [`Self::drop_prefixes`] let go, its
+    /// evaluations on the subdomain of its size: the first of the `2^log_blowup_factor` parts of its
+    /// domain, which the FRI quotients read.
+    pub fn restore_prefixes(
+        &mut self,
+        log_blowup_factor: u32,
+        twiddles: &TwiddleTree<B>,
+        base_column_pool: &BaseColumnPool<B>,
+    ) {
+        let dropped = |poly: &Poly<B>| poly.coeffs.is_some() && poly.evals.values.is_empty();
+        if !self.polynomials.iter().any(dropped) {
+            return;
+        }
+        let _span = span!(Level::INFO, "Restore prefixes").entered();
+        let part_twiddles: HashMap<u32, TwiddleTree<B>> = self
+            .polynomials
+            .iter()
+            .filter(|poly| dropped(poly))
+            .map(|poly| poly.evals.domain.log_size())
+            .sorted()
+            .dedup()
+            .map(|log_size| {
+                let domain = CanonicCoset::new(log_size).circle_domain();
+                (log_size, B::part_twiddles(domain, log_blowup_factor, 0, twiddles))
+            })
+            .collect();
+        let restore = |poly: &mut Poly<B>| {
+            if !dropped(poly) {
+                return;
+            }
+            let domain = poly.evals.domain;
+            let buffer = base_column_pool.take_or_alloc(domain.log_size() - log_blowup_factor);
+            let coeffs = poly.coeffs.as_ref().unwrap();
+            poly.evals.values = B::evaluate_into(
+                coeffs,
+                part_domain(domain, log_blowup_factor, 0),
+                &part_twiddles[&domain.log_size()],
+                buffer,
+            )
+            .values;
+        };
+        #[cfg(feature = "parallel")]
+        {
+            use rayon::iter::IntoParallelRefMutIterator;
+            self.polynomials.par_iter_mut().for_each(restore);
+        }
+        #[cfg(not(feature = "parallel"))]
+        self.polynomials.iter_mut().for_each(restore);
+    }
+
