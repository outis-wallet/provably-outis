+pub fn eval_at_domain_indices_by_points<B: PolyOps>(
+    poly: &CircleCoefficients<B>,
+    domain: CircleDomain,
+    indices: &[usize],
+) -> Vec<BaseField> {
+    indices
+        .iter()
+        .map(|&index| {
+            let point = domain.at(bit_reverse_index(index, domain.log_size()));
